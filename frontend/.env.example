# ==============================================================================
# IT Incident Hub — Frontend Environment Variables Template (Vite / React)
# ==============================================================================
# Copy this file to .env and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER commit a real .env file — it is excluded by .gitignore.
# ==============================================================================

# ── API Base URL ──────────────────────────────────────────────────────────────
# In development the Vite dev-server proxy forwards /api → localhost:8080,
# so this default works out of the box.
# In production (Render static site) set this to the full backend URL, e.g.:
#   VITE_API_URL=https://incident-hub-backend.onrender.com/api/v1
VITE_API_URL=/api/v1
