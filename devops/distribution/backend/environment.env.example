# ==============================================================================
# IT Incident Hub - Distribution Backend Environment Template
# ==============================================================================
# Copie este archivo a .env y configure los valores de conexión a PostgreSQL.
# NUNCA versione el archivo .env real.
# ==============================================================================

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incident_hub_db
DB_USERNAME=incident_user
DB_PASSWORD=<CHANGE_ME>

# Backend Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
