# IT Incident Hub - Environment Variables Template
# Copy this file to .env and replace placeholders with secure local values.
# NEVER commit real .env files with secrets into git repositories.

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/incident_hub_db
DB_NAME=incident_hub_db
DB_USERNAME=incident_user
DB_PASSWORD=incident_pass_secret

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend Configuration
VITE_API_URL=/api/v1
PORT=3000

# GitLab CI/CD Variables (Used in Runner & API Scripts)
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_PROJECT_ID=12345678
# GITLAB_URL=https://gitlab.com
