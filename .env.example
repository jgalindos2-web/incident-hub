# ==============================================================================
# IT Incident Hub — Root Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace every placeholder with your real values.
# NEVER commit a real .env file — it is excluded by .gitignore.
# ==============================================================================

# ── Database Credentials (used by docker-compose and backend) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incident_hub_db
DB_USERNAME=incident_user
DB_PASSWORD=<CHANGE_ME>                       # Required — set a strong password

# ── Backend Server Configuration ─────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev                    # dev | prod

# ── Frontend Configuration (Vite — must start with VITE_) ────────────────────
VITE_API_URL=/api/v1                          # Proxy target handled by vite.config.js

# ── GitLab CI/CD Variables (configure ONLY in GitLab > Settings > CI/CD) ──────
# These are used by the deploy job and must NEVER be stored in files:
#   RENDER_DEPLOY_HOOK_BACKEND  — Render deploy hook URL for the backend service
#   RENDER_DEPLOY_HOOK_FRONTEND — Render deploy hook URL for the frontend service