# ==============================================================================
# IT Incident Hub — Backend Environment Variables Template
# ==============================================================================
# Copy this file to .env and set the values for your local PostgreSQL instance.
# The Spring Boot application.properties reads these via ${VAR} placeholders.
# NEVER commit a real .env file — it is excluded by .gitignore.
# ==============================================================================

# ── PostgreSQL Connection ─────────────────────────────────────────────────────
DB_HOST=localhost                              # PostgreSQL hostname
DB_PORT=5432                                   # PostgreSQL port
DB_NAME=incident_hub_db                        # Database name
DB_USERNAME=incident_user                      # Database user
DB_PASSWORD=<CHANGE_ME>                        # Required — use a strong password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080                                      # HTTP listen port
SPRING_PROFILES_ACTIVE=dev                     # Spring profile: dev | prod

# ── CORS (production only, configured in Render Dashboard) ────────────────────
# CORS_ALLOWED_ORIGINS=https://incident-hub-frontend.onrender.com
